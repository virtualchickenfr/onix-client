<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the Windows installer (paste it into the SignPath project).
     The GitHub workflow uploads the installer zipped, as GitHub artifacts always are. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Onix-Client-Setup-*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
