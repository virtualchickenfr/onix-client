{
  "name": "onix-client-launcher",
  "productName": "Onix Client",
  "version": "1.0.34",
  "description": "Launcher for Onix Client (Onix on Minecraft 1.21.1, 1.21.4, 1.21.6-1.21.8, 1.21.10 and 1.21.11; every Fabric version playable)",
  "main": "main.js",
  "author": "Onix",
  "license": "LicenseRef-Proprietary",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "tar": "^7.4.3",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.onix.client",
    "productName": "Onix Client",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../mod/build/libs/",
        "to": "mods/1.21.1",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../mod-1.21.11/build/libs/",
        "to": "mods/1.21.11",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../ports/build/jars/onix-client-mod-port-1.21.10/",
        "to": "mods/1.21.10",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../ports/build/jars/onix-client-mod-port-1.21.8/",
        "to": "mods/1.21.8",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../ports/build/jars/onix-client-mod-port-1.21.7/",
        "to": "mods/1.21.7",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../ports/build/jars/onix-client-mod-port-1.21.6/",
        "to": "mods/1.21.6",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      },
      {
        "from": "../ports/build/jars/onix-client-mod-port-1.21.4/",
        "to": "mods/1.21.4",
        "filter": [
          "onix-client-*.jar",
          "!*-sources.jar"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Onix Client",
      "differentialPackage": true,
      "license": "build/license.txt"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "fileAssociations": [
      {
        "ext": "dawnpack",
        "name": "Dawn modpack",
        "description": "Modpack \u2013 opens in Onix Client",
        "role": "Viewer"
      },
      {
        "ext": "mrpack",
        "name": "Modrinth modpack",
        "description": "Modpack \u2013 opens in Onix Client",
        "role": "Viewer"
      }
    ]
  }
}
